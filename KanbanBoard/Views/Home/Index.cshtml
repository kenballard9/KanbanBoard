@model IEnumerable<KanbanBoard.Models.KanbanTask>
@using KanbanBoard.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Kanban Board</title>
    <!-- Quill CSS -->
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">

    <style>
        body {
            font-family: Arial;
            background: #f4f6f8;
            margin: 0;
        }

        .top-bar {
            text-align: center;
            padding: 20px;
            display: flex;
            justify-content: center;
            gap: 10px;
            align-items: center;
        }

        .search-box {
            padding: 8px;
            width: 250px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        .btn-primary {
            background: #1a3e72;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
        }

            .btn-primary:hover {
                background: #0f2c53;
            }

        .btn-cancel {
            background: #ccc;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
        }

            .btn-cancel:hover {
                background: #aaa;
            }

        .kanban-container {
            display: flex;
            gap: 20px; /* spacing between columns */
            padding: 20px;
            justify-content: flex-start;
            width: auto; /* increased container width */
            margin: 0 auto; /* center container */
        }

        .column {
            background: #e8ebf1;
            border-radius: 8px;
            width: 420px; /* wider column */
            display: flex;
            flex-direction: column;
            padding: 10px;
        }

            .column h3 {
                text-align: center;
                margin-bottom: 10px;
                color: #1a3e72;
            }

        .task-card {
            background: #fff;
            border-radius: 6px;
            padding: 10px;
            margin-bottom: 10px;
            box-shadow: 0px 2px 4px rgba(0,0,0,0.1);
            cursor: grab;
        }

        .comment {
            background: #f0f2f5;
            border-radius: 4px;
            padding: 5px;
            margin-top: 5px;
        }

        .quill-container {
            height: 80px;
            margin-top: 5px;
            margin-bottom: 5px;
            width: 100%;
        }

        .modal {
            display: none; /* Hidden by default */
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: #fff;
            padding: 2rem;
            border-radius: 12px;
            width: 400px;
            max-width: 90%;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .urgency-options {
            display: flex;
            justify-content: space-between;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 1rem;
        }

        /* Date picker styling */
        #taskDueDate {
            padding: 8px;
            border-radius: 6px;
            border: 1px solid #ccc;
            width: 100%;
            box-sizing: border-box;
            font-size: 14px;
        }
    </style>
</head>
<body>

    <div class="top-bar">
        <input type="text" id="searchBox" class="search-box" placeholder="Search by Title or Description..." />
        <button id="addTaskBtn" class="btn-primary">+ Add Task</button>
    </div>

    <div class="kanban-container">
        @foreach (var status in Enum.GetValues(typeof(StatusOfTask)).Cast<StatusOfTask>())
        {
            <div class="column" data-status="@status">
                <h3>@status.ToString()</h3>

                @foreach (var t in Model.Where(m => m.Status == status))
                {
                    <div class="task-card" draggable="true" data-taskid="@t.Id">
                        <strong class="task-title">@t.Title</strong>
                        <p class="task-desc">@t.Description</p>
                        <p class="urgency">Urgency: @t.Urgency.ToString()</p>
                        <p class="due-date">Due: @t.DueDate.ToString("yyyy-MM-dd")</p>



                        <div>
                            @foreach (var c in t.Comments ?? new List<Comment>())
                            {
                                <div class="comment">@Html.Raw(c.Content)</div>
                            }
                            <div class="quill-container" data-taskid="@t.Id"></div>
                            <button class="btn-primary add-comment-btn" data-taskid="@t.Id">Add Comment</button>
                            <button class="btn-primary delete-task-btn" data-taskid="@t.Id">Delete</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Add Task Modal-->
    <div id="taskModal" class="modal">
        <div class="modal-content">
            <h3>Add New Task</h3>

            <input type="text" id="taskTitle" placeholder="Title" />
            <textarea id="taskDescription" placeholder="Description"></textarea>

            <!-- ✅ Urgency radios -->
            <div class="urgency-options">
                <label><input type="radio" name="taskUrgency" value="Low" checked /> Low</label>
                <label><input type="radio" name="taskUrgency" value="Medium" /> Medium</label>
                <label><input type="radio" name="taskUrgency" value="High" /> High</label>
                <label><input type="radio" name="taskUrgency" value="Critical" /> Critical</label>
            </div>

            <!-- ✅ Due Date -->
            <label for="taskDueDate">Due Date:</label>
            <input type="date" id="taskDueDate" />

            <div class="modal-buttons">
                <button id="cancelBtn" class="btn-cancel">Cancel</button>
                <button id="submitTaskBtn" class="btn-primary">Add Task</button>
            </div>
        </div>
    </div>

    <!-- Quill JS -->
    <script src="https://cdn.quilljs.com/1.3.7/quill.js"></script>

    <script>
        const modal = document.getElementById("taskModal");
        const taskTitle = document.getElementById("taskTitle");
        const taskDescription = document.getElementById("taskDescription");
        const taskDueDate = document.getElementById("taskDueDate");

        // Open modal
        document.getElementById("addTaskBtn").onclick = () => {
            taskTitle.value = "";
            taskDescription.value = "";
            taskDueDate.value = "";
            document.querySelector('input[name="taskUrgency"][value="Low"]').checked = true;
            modal.style.display = "flex";
        };

        // Close modal
        document.getElementById("cancelBtn").onclick = () => modal.style.display = "none";
        window.onclick = e => { if (e.target == modal) modal.style.display = "none"; };

        // Add Task
        document.getElementById("submitTaskBtn").onclick = () => {
            const title = taskTitle.value.trim();
            const desc = taskDescription.value.trim();
            const dueDate = taskDueDate.value; // capture date
            let urgency = document.querySelector('input[name="taskUrgency"]:checked').value;

            if (!title) {
                alert("Title required");
                return;
            }

            // Append Unicode circle based on urgency
            switch (urgency.toLowerCase()) {
                case 'low':
                    urgency += " 🟢";
                    break;
                case 'medium':
                    urgency += " 🟡";
                    break;
                case 'high':
                case 'critical':
                    urgency += " 🔴";
                    break;
            }

            fetch('@Url.Action("AddTask", "Home")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Title: title, Description: desc, Urgency: urgency, DueDate: dueDate })
            }).then(() => {
                modal.style.display = "none";
                location.reload();
            });
        };

        // Quill editors
        const quills = {};
        document.querySelectorAll(".quill-container").forEach(div => {
            const taskId = div.dataset.taskid;
            quills[taskId] = new Quill(div, { theme: 'snow', placeholder: 'Add comment...' });
        });

        // Comments & delete
        document.querySelector(".kanban-container").addEventListener("click", function (e) {
            if (e.target && e.target.classList.contains("add-comment-btn")) {
                const btn = e.target;
                const taskId = btn.dataset.taskid;
                const quill = quills[taskId];
                const content = quill.root.innerHTML.trim();
                if (!content || content === '<p><br></p>') return;

                fetch('@Url.Action("AddComment", "Home")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ TaskId: taskId, Content: content })
                }).then(resp => {
                    if (!resp.ok) throw new Error("Failed to add comment");
                    const newCommentDiv = document.createElement("div");
                    newCommentDiv.className = "comment";
                    newCommentDiv.innerHTML = content;
                    btn.parentElement.insertBefore(newCommentDiv, btn.previousElementSibling);
                    quill.root.innerHTML = "";
                }).catch(console.error);
            }

            if (e.target && e.target.classList.contains("delete-task-btn")) {
                if (!confirm("Delete this task?")) return;
                const taskId = e.target.dataset.taskid;
                fetch('@Url.Action("DeleteTask", "Home")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ TaskId: taskId })
                }).then(() => location.reload());
            }
        });

        // Drag & drop
        let draggedTask = null;
        document.querySelectorAll(".task-card").forEach(task => {
            task.addEventListener("dragstart", e => { draggedTask = task; });
        });

        document.querySelectorAll(".column").forEach(col => {
            col.addEventListener("dragover", e => e.preventDefault());
            col.addEventListener("drop", e => {
                e.preventDefault();
                if (!draggedTask) return;
                col.appendChild(draggedTask);
                const taskId = draggedTask.dataset.taskid;
                const newStatus = col.dataset.status;
                fetch('@Url.Action("MoveTask", "Home")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Id: taskId, NewStatus: newStatus })
                }).catch(console.error);
                draggedTask = null;
            });
        });

        // Search
        const searchBox = document.getElementById("searchBox");
        searchBox.addEventListener("input", () => {
            const query = searchBox.value.toLowerCase();
            document.querySelectorAll(".task-card").forEach(task => {
                const title = task.querySelector(".task-title").textContent.toLowerCase();
                const desc = task.querySelector(".task-desc").textContent.toLowerCase();
                task.style.display = (title.includes(query) || desc.includes(query)) ? "block" : "none";
            });
        });
    </script>
</body>
</html>
